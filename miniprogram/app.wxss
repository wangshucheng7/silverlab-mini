/* 全局深炭黑暗房主题基础样式 */
page {
  background-color: #0D0D0F;
  color: #F5F5F7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  height: 100%;
  overflow: hidden;
}

view,
text,
button,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}
